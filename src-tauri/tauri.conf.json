{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inverter Desktop",
  "identifier": "com.alvit.inverter-dashboard",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Inverter Desktop",
        "width": 800,
        "height": 900,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": [
          "'self'"
        ],
        "script-src": [
          "'self'"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "img-src": [
          "'self'",
          "data:",
          "blob:"
        ],
        "font-src": [
          "'self'",
          "data:"
        ],
        "connect-src": [
          "'self'",
          "ws://*",
          "wss://*",
          "http://*",
          "https://*",
          "https://api.github.com",
          "https://github.com",
          "https://objects.githubusercontent.com"
        ],
        "object-src": [
          "'none'"
        ],
        "base-uri": [
          "'self'"
        ],
        "form-action": [
          "'self'"
        ],
        "frame-ancestors": [
          "'none'"
        ],
        "media-src": [
          "'self'",
          "blob:",
          "http://*",
          "https://*",
          "asset:",
          "plugin-media:",
          "http://plugin-media.localhost",
          "https://plugin-media.localhost",
          "http://asset.localhost",
          "https://asset.localhost"
        ]
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$TEMP/inverter-desktop-camera/**"
        ]
      }
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "iOS": {
      "bundleVersion": "2.5.42"
    },
    "icon": [
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      },
      "bundleVersion": "2.5.42"
    }
  },
  "version": "2.5.43"
}
