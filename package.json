{
  "name": "inverter_dashboard",
  "private": true,
  "version": "2.5.43",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-frontend.mjs",
    "build:mobile": "node scripts/build-frontend.mjs mobile",
    "test:build-profiles": "node --test scripts/frontend-profile.test.mjs",
    "test:mobile": "vitest run --config vitest.mobile.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"*.ts\"",
    "lint": "biome lint src"
  },
  "dependencies": {
    "@lucide/vue": "^1.23.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-store": "^2",
    "@univerjs/preset-sheets-core": "1.0.0",
    "@univerjs/presets": "1.0.0",
    "echarts": "^6.1.0",
    "vue": "^3.5.35",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "glob": "10.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "undici": "7.29.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.11"
  },
  "pnpm": {
    "overrides": {
      "undici": "7.29.1",
      "glob": "11.1.0",
      "nanoid": "5.1.16",
      "postcss": "8.5.26",
      "js-yaml": "5.3.0",
      "ip-address": "10.5.0",
      "fast-uri": "3.1.7"
    }
  }
}
