{
  "name": "inverter_dashboard",
  "private": true,
  "version": "2.5.44",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-frontend.mjs",
    "build:mobile": "node scripts/build-frontend.mjs mobile",
    "test:build-profiles": "node --test scripts/frontend-profile.test.mjs",
    "test:mobile": "vitest run --config vitest.mobile.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"*.ts\"",
    "lint": "biome lint src"
  },
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-store": "^2",
    "@univerjs/preset-sheets-core": "1.0.2",
    "@univerjs/presets": "1.0.2",
    "echarts": "^6.1.0",
    "vue": "^3.5.35",
    "vue-echarts": "^8.3.0",
    "vue-i18n": "^11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tauri-apps/cli": "^2.11.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.11"
  }
}
